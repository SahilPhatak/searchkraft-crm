# ── Database ──────────────────────────────────────────────────────
# Supabase connection string (from Supabase → Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # From Supabase → Settings → API → service_role key

# ── Auth ──────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ── App ───────────────────────────────────────────────────────────
PORT=10000
NODE_ENV=production
FRONTEND_URL=https://your-cloudfront-domain.cloudfront.net
