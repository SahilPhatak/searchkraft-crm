generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Profiles (auth users) ────────────────────────────────────
model Profile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String
  role      String   @default("User")
  title     String?
  dept      String?
  phone     String?
  avatar    String?
  color     String?  @default("#1a56db")
  status    String?  @default("active")
  online    Boolean? @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("profiles")
}

// ── Leads ─────────────────────────────────────────────────────
model Lead {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  email             String?
  phone             String?
  company           String?
  title             String?
  source            String?
  stage             String?   @default("New")
  rating            Int?
  value             Decimal?
  notes             String?
  owner             String?
  ownerId           String?   @map("owner_id") @db.Uuid
  // Extended
  salutation        String?
  firstName         String?   @map("first_name")
  lastName          String?   @map("last_name")
  email2            String?
  website           String?
  skype             String?
  twitter           String?
  industry          String?
  numEmployees      Int?      @map("num_employees")
  annualRevenue     Decimal?  @map("annual_revenue")
  emailOptOut       Boolean?  @default(false) @map("email_opt_out")
  handoverDate      DateTime? @map("handover_date") @db.Date
  followupDate      DateTime? @map("followup_date") @db.Date
  followupStatus    String?   @map("followup_status")
  followupNotes     String?   @map("followup_notes")
  lane              String?
  sourceSD          String?   @map("source_sd")
  leadType          String?   @map("lead_type")
  month             String?
  handoverDone      Boolean?  @default(false) @map("handover_done")
  clientName        String?   @map("client_name")
  compensation      String?
  clientType        String?   @map("client_type")
  deliveryPOC       String?   @map("delivery_poc")
  agreement         String?
  numPositions      Int?      @map("num_positions")
  commercialsSigned Boolean?  @default(false) @map("commercials_signed")
  country           String?
  addrLine1         String?   @map("addr_line1")
  street            String?
  city              String?
  state             String?
  zip               String?
  description       String?
  wonAt             DateTime? @map("won_at")
  lostAt            DateTime? @map("lost_at")
  lostReason        String?   @map("lost_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @map("updated_at")

  @@map("leads")
}

// ── Contacts ──────────────────────────────────────────────────
model Contact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String?
  phone     String?
  title     String?
  dept      String?
  company   String?
  companyId String?  @map("company_id") @db.Uuid
  owner     String?
  ownerId   String?  @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("contacts")
}

// ── Companies (Accounts) ──────────────────────────────────────
model Company {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  industry  String?
  website   String?
  phone     String?
  employees Int?
  revenue   Decimal?
  address   String?
  city      String?
  state     String?
  country   String?  @default("India")
  status    String?  @default("Active")
  bdOwner   String?  @map("bd_owner")
  ownerId   String?  @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("companies")
}

// ── Deals ─────────────────────────────────────────────────────
model Deal {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  stage           String?   @default("Prospecting")
  value           Decimal?
  amount          Decimal?  @default(0)
  expectedRevenue Decimal?  @default(0) @map("expected_revenue")
  currency        String?   @default("INR")
  closeDate       DateTime? @map("close_date") @db.Date
  probability     Int?
  source          String?
  notes           String?
  contact         String?
  contactId       String?   @map("contact_id") @db.Uuid
  company         String?
  companyId       String?   @map("company_id") @db.Uuid
  owner           String?
  ownerId         String?   @map("owner_id") @db.Uuid
  wonAt           DateTime? @map("won_at")
  lostAt          DateTime? @map("lost_at")
  lostReason      String?   @map("lost_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @map("updated_at")

  @@map("deals")
}

// ── Tasks ─────────────────────────────────────────────────────
model Task {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  type        String?
  description String?
  dueDate     DateTime? @map("due_date") @db.Date
  status      String?   @default("Pending")
  priority    String?   @default("Normal")
  relatedTo   String?   @map("related_to")
  owner       String?
  ownerId     String?   @map("owner_id") @db.Uuid
  leadId      String?   @map("lead_id") @db.Uuid
  contactId   String?   @map("contact_id") @db.Uuid
  dealId      String?   @map("deal_id") @db.Uuid
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")

  @@map("tasks")
}

// ── Activities ────────────────────────────────────────────────
model Activity {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        String
  subject     String
  description String?
  date        DateTime  @default(now())
  duration    Int?
  outcome     String?
  owner       String?
  ownerId     String?   @map("owner_id") @db.Uuid
  leadId      String?   @map("lead_id") @db.Uuid
  contactId   String?   @map("contact_id") @db.Uuid
  dealId      String?   @map("deal_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("activities")
}

// ── Audit Logs ────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action     String
  module     String
  recordId   String?  @map("record_id") @db.Uuid
  recordName String?  @map("record_name")
  userName   String?  @map("user_name")
  userId     String?  @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
